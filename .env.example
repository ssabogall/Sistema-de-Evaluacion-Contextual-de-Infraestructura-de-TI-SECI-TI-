# Provider used by the PB-01 requirement extractor: "openai" or "gemini".
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# Comma-separated browser origins allowed by the backend.
FRONTEND_ORIGINS=http://localhost:5173

# Optional when the frontend is served separately without Vite's local proxy.
VITE_API_BASE_URL=

# AWS is optional. Enabling the connection alone does not create resources.
AWS_ENABLED=false
AWS_ALLOW_DEPLOYMENTS=false
AWS_REGION=us-east-1
AWS_STACK_PREFIX=seci-ti
AWS_INSTANCE_TYPE=t3.micro

# Choose credentials OR an existing SDK/CLI profile, not both.
# Learner Lab needs all three values; renew them when the lab session expires.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# AWS_PROFILE=seci-ti

# Recommended guard: only accept this AWS account (12 digits).
# AWS_EXPECTED_ACCOUNT_ID=123456789012

# Optional: SQLite file where confirmed cases are stored (created on first use).
# Default: data/seci_ti.sqlite3 at the repository root. Leave commented to use the default.
# DATABASE_PATH=data/seci_ti.sqlite3
